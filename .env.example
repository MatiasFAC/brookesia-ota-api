# Configuración de la API OTA. Este archivo se escribe en el servidor con
# permisos 0600 y lo genera el pipeline de despliegue a partir de los secrets
# del repositorio. NO versionar el archivo real: solo esta plantilla.

# Token de GitHub con permiso de lectura sobre el repositorio privado del
# firmware (MatiasFAC/esp-brookesia-jc4880). Es un PAT con scope "repo".
OTA_GITHUB_TOKEN=cambia-esto

# Repositorio de donde se lee el release con el binario.
OTA_GITHUB_OWNER=MatiasFAC
OTA_GITHUB_REPO=esp-brookesia-jc4880

# URL pública con la que se publica el binario en el manifiesto.
OTA_PUBLIC_URL=https://ota.m-a.dev

# Tiempo (segundos) que se cachea el manifiesto en memoria.
OTA_MANIFEST_TTL=30

# Nivel de log de la API.
OTA_LOG_LEVEL=INFO
