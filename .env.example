# Configuración de la API OTA. Este archivo se escribe en el servidor con
# permisos 0600 y lo genera el pipeline de despliegue a partir de los secrets
# del repositorio. NO versionar el archivo real: solo esta plantilla.

# Token que protege el endpoint de subida (POST /upload/<canal>).
# La API lo exige para aceptar un binario nuevo. El pipeline de release del
# firmware tiene que mandar exactamente el mismo valor.
OTA_UPLOAD_TOKEN=cambia-esto

# URL pública con la que se publica el binario en el manifiesto.
OTA_PUBLIC_URL=https://ota.m-a.dev

# Directorio donde se guardan los binarios (un .bin y un .json por canal).
OTA_CACHE_DIR=/var/cache/brookesia-ota

# Tamaño máximo admitido en una subida (bytes).
OTA_MAX_UPLOAD_BYTES=33554432

# Nivel de log de la API.
OTA_LOG_LEVEL=INFO
